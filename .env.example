# Flask
SECRET_KEY=dev-secret-key-change-me
FLASK_ENV=development
DATABASE_URL=sqlite:///low_carbon_screener.db

# Live quotes: screener refreshes TradingView at most every CACHE_TTL seconds
CACHE_TTL=300
LIVE_QUOTES=true
TRADINGVIEW_ENABLED=true
# Optional HTTP proxy just for TradingView (Clash: http://127.0.0.1:7890)
TRADINGVIEW_PROXY=

# Daily close snapshot (America/New_York weekdays). Carbon: 1st of month 06:00 UTC.
SCHEDULER_ENABLED=true
MARKET_TIMEZONE=America/New_York
MARKET_SYNC_CRON=16:45

# Clarity AI SFDR — https://developer.clarity.ai/docs/sfdr
# Leave blank to keep seeded mock carbon data.
CLARITY_API_KEY=
CLARITY_API_SECRET=
CLARITY_BASE_URL=https://api.clarity.ai/clarity/v1

# Password reset email. Leave blank in class/dev — the code is logged and returned as dev_code.
RESEND_API_KEY=
EMAIL_FROM=低碳价值筛选器 <noreply@lowcarbon.io>
# Optional SMTP fallback if not using Resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
